# Semcode Configuration Example
# Copy this file to .env and adjust values for your environment.
#
# -----------------------------------------------------------------------------
# Minimum configuration (see README.md "Getting Started")
# -----------------------------------------------------------------------------
# To get semcode running you only need to set the following variables; the
# rest can stay at their defaults:
#   - SEMCODE_WORKSPACE_ROOT          location to mirror repositories
#   - OPENAI_API_KEY                  (or an equivalent provider key:
#                                      COHERE_API_KEY, JINA_API_KEY,
#                                      HUGGINGFACEHUB_API_TOKEN)
#   - SEMCODE_EMBEDDING_MODEL         must match SEMCODE_EMBEDDING_DIMENSION
#                                      and the Milvus collection dimension
#   - SEMCODE_MILVUS_URI              plus optional username/password
# Optional but commonly tuned:
#   - SEMCODE_API_KEY                 enforced by the FastAPI layer and UIs
#   - SEMCODE_TELEMETRY_ENABLED=false to disable in-memory telemetry
# -----------------------------------------------------------------------------

# =============================================================================
# Workspace & General Settings
# =============================================================================
SEMCODE_WORKSPACE_ROOT=./workspace
SEMCODE_API_KEY=
SEMCODE_TELEMETRY_ENABLED=true

# =============================================================================
# Milvus Vector Database
# =============================================================================
SEMCODE_MILVUS_URI=http://localhost:19530
SEMCODE_MILVUS_USERNAME=
SEMCODE_MILVUS_PASSWORD=

# =============================================================================
# Embedding Provider Configuration
# =============================================================================
SEMCODE_EMBEDDING_PROVIDER=openai
SEMCODE_EMBEDDING_MODEL=text-embedding-3-large
SEMCODE_EMBEDDING_DIMENSION=3072
SEMCODE_EMBEDDING_API_BASE=
SEMCODE_EMBEDDING_API_KEY=
SEMCODE_EMBEDDING_USE_TIKTOKEN=true
SEMCODE_EMBEDDING_BATCH_SIZE=64

# Embedding Provider API Keys (alternative location)
OPENAI_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
HUGGINGFACEHUB_API_TOKEN=

# =============================================================================
# Llama.cpp Embedding Configuration
# =============================================================================
SEMCODE_EMBEDDING_LLAMACPP_MODEL_PATH=
SEMCODE_EMBEDDING_LLAMACPP_N_CTX=2048
SEMCODE_EMBEDDING_LLAMACPP_N_THREADS=4
SEMCODE_EMBEDDING_LLAMACPP_BATCH_SIZE=256

# =============================================================================
# RAG/LLM Provider Configuration
# =============================================================================
SEMCODE_RAG_PROVIDER=openai
SEMCODE_RAG_MODEL=gpt-4o
SEMCODE_DEFAULT_LLM=gpt-4o
SEMCODE_RAG_API_BASE=
SEMCODE_RAG_API_KEY=
SEMCODE_RAG_TEMPERATURE=0.0
SEMCODE_RAG_SYSTEM_PROMPT=You are a senior software engineer helping teammates understand codebases. Use the provided context to answer succinctly and cite files that support your answer.
SEMCODE_RAG_PROMPT_TEMPLATE=
SEMCODE_RAG_FALLBACK_ENABLED=true
SEMCODE_RAG_MAX_CONTEXT_SOURCES=5
SEMCODE_RAG_FALLBACK_MAX_SOURCES=3
SEMCODE_RAG_FALLBACK_SUMMARY_SENTENCES=3

# =============================================================================
# Llama.cpp RAG Configuration
# =============================================================================
SEMCODE_RAG_LLAMACPP_MODEL_PATH=
SEMCODE_RAG_LLAMACPP_N_CTX=2048
SEMCODE_RAG_LLAMACPP_N_THREADS=4

# =============================================================================
# Ingestion Settings
# =============================================================================
SEMCODE_CHUNK_CHARS_PER_TOKEN_ESTIMATE=1.0

# =============================================================================
# Milvus Storage Settings
# =============================================================================
SEMCODE_MILVUS_UPSERT_BATCH_SIZE=128

# =============================================================================
# API Server Configuration
# =============================================================================
SEMCODE_API_HOST=0.0.0.0
SEMCODE_API_PORT=8000

# =============================================================================
# Frontend Configuration
# =============================================================================
SEMCODE_FRONTEND_API_ROOT=http://localhost:8000
SEMCODE_FRONTEND_API_KEY=
SEMCODE_FRONTEND_PORT=8501
SEMCODE_FRONTEND_REQUEST_TIMEOUT=30

# =============================================================================
# Environment Settings
# =============================================================================
TOKENIZERS_PARALLELISM=false